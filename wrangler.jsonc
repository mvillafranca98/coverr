{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coverr",
  "account_id": "f1b142072a65e92e0f2913f67917d8e1",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coverr-db",
      "database_id": "f823e8a0-b581-4950-beaa-d2f340f57396",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROOFS",
      "bucket_name": "coverr-proofs"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://coverr.a-mencias99.workers.dev",
    "EMAIL_FROM": "Coverr <coverr@macawly.dev>"
  }
}
