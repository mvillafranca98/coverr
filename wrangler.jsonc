{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coverr",
  "account_id": "f1b142072a65e92e0f2913f67917d8e1",
  "main": "src/index.tsx",

  // Stylesheets live in src/styles/*.css but still reach the browser inlined in
  // the HTML, never as a second request: a buyer on venue wifi mid-transfer
  // should not wait on one. Importing a .css file yields its text, bundled
  // into the Worker. fallthrough keeps wrangler's default Text rule (.txt,
  // .html, .sql) alive instead of silently shadowing it.
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],

  // Custom domains: Cloudflare creates their DNS records and certificates on
  // deploy, which needs the coverr.live zone active on this account first.
  "routes": [
    { "pattern": "coverr.live", "custom_domain": true },
    { "pattern": "www.coverr.live", "custom_domain": true }
  ],
  // Has to be said out loud: with routes present, wrangler would switch the
  // workers.dev address off, and every ticket email and link sent before
  // coverr.live existed points there. It redirects instead (REDIRECT_HOSTS).
  "workers_dev": true,
  // Without this, `wrangler dev` presents every local request as one to the
  // first route, http://coverr.live, and the app's https redirect sends each
  // page back to itself forever.
  "dev": { "host": "localhost" },

  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Without this, every stack trace in a crash alert points into the bundled
  // worker — one enormous line, which tells you nothing. With it, the frames
  // name the .ts file and line that actually threw.
  "upload_source_maps": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coverr-db",
      "database_id": "f823e8a0-b581-4950-beaa-d2f340f57396",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROOFS",
      "bucket_name": "coverr-proofs"
    }
  ],
  // Cloudflare's own rate limiter. Periods are limited to 10 or 60 seconds,
  // hence the per-minute windows.
  // Daily, for the proof purge. The window is 30 days past the event, so the
  // exact hour is irrelevant — what matters is that it runs at all.
  "triggers": { "crons": ["0 3 * * *"] },
  "ratelimits": [
    {
      "name": "PURCHASE_LIMIT",
      "namespace_id": "1001",
      // Deliberately loose. Walk-up buyers at the door self-serve through this
      // same flow on one venue wifi, so they all share an IP — a tight cap
      // would stall the queue the product exists to unstall. This is a ceiling
      // on a runaway vision bill, not a precision control.
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "EMAIL_LIMIT",
      "namespace_id": "1002",
      // Sign-in, sign-up, ticket recovery and refund requests each send mail.
      // A human needs one or two a minute; nothing legitimate needs five.
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "EXTRACT_LIMIT",
      "namespace_id": "1003",
      // The band's "read it again" button on an order, one paid vision call a
      // press. Counted per band. Ten a minute lets a band clear a backlog of
      // failed reads after an outage; the proof_extraction switch is the stop
      // for a bill that runs away anyway.
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://coverr.live",

    // Answer with a redirect to APP_ORIGIN instead of serving the site
    // (lib/host-redirect.ts). The workers.dev address is where Coverr lived
    // until November 2026; it stays listed for as long as old links exist.
    "REDIRECT_HOSTS": ["www.coverr.live", "coverr.a-mencias99.workers.dev"],

    // The sender on every email. coverr.live is verified in Resend, and the
    // RESEND_API_KEY secret may only send from that domain, so the two change
    // together. Replies reach the hola@ inbox through Cloudflare Email
    // Routing. See docs/EMAIL-SETUP.md before touching either.
    "EMAIL_FROM": "Coverr <hola@coverr.live>",

    // Who may sign in to /operador, Coverr's back office (lib/operator.ts).
    // Checked on every request, so removing an address ends that person's
    // access on their next click. Addresses, not secrets: in the open on
    // purpose, like ALERT_EMAIL below. hola@ is a shared inbox: its sign-in
    // links reach whoever Email Routing forwards it to, so adding a forwarding
    // destination there makes that person an operator too.
    "OPERATOR_EMAILS": ["hola@coverr.live", "mvillafranca98@gmail.com", "a.mencias99@gmail.com"],

    // Who hears about a crash. The operator, not a band: a band can do nothing
    // about a stack trace. Not a secret — an address, in the open on purpose so
    // `wrangler deploy --dry-run` shows whether alerting is wired up at all.
    "ALERT_EMAIL": "a.mencias99@gmail.com"
  }
}
