{
  "name": "coverr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply coverr-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply coverr-db --remote",
    "db:seed:local": "wrangler d1 execute coverr-db --local --file=./seed/seed.sql",
    "db:reset": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed:local",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "qrcode-generator": "^1.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2",
    "wrangler": "^4.128.0"
  }
}
