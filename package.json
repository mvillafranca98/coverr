{
  "name": "coverr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply coverr-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply coverr-db --remote",
    "db:seed:local": "wrangler d1 execute coverr-db --local --file=./seed/seed.sql",
    "db:reset": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed:local",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "shots": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "hono": "^4.13.13",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^1.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "drizzle-kit": "^0.31.10",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.128.0"
  }
}
